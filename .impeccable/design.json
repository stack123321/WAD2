      "html": "<section class=\"ds-panel\"><h3 class=\"ds-title\">Rain at eight? We’ll know.</h3><p class=\"ds-text\">29°C · Partly cloudy · Indoor picks first</p></section>",
      "css": ".ds-panel{padding:1.75rem;background:var(--fp-surface,#f5f5f3);border-radius:28px}.ds-title{margin:0;font:700 1.5rem/1.2 Fraunces,Georgia,serif;letter-spacing:-.01em;color:var(--fp-ink,#111)}.ds-text{margin:.5rem 0 0;font:400 1.0625rem/1.5 \"DM Sans\",system-ui,sans-serif;color:var(--fp-muted,#555)}"
    },
