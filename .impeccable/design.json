  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one black pill per section.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Create account</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;min-height:44px;padding:.7rem 1.4rem;border:0;border-radius:999px;font:700 1rem/1.5 \"DM Sans\",system-ui,sans-serif;cursor:pointer;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),background-color 160ms cubic-bezier(0.23,1,0.32,1),color 160ms cubic-bezier(0.23,1,0.32,1)}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:2px solid var(--fp-primary,#0e7c6b);outline-offset:3px}@media (prefers-reduced-motion:reduce){.ds-btn{transition:none}.ds-btn:active{transform:none}}.ds-btn-primary{background:var(--fp-ink,#111);color:var(--fp-bg,#fff)}.ds-btn-primary:hover{background:var(--fp-ink-hover,#2a2a2a)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Grey pill for secondary and repeated list actions.",
      "html": "<button class=\"ds-btn ds-btn-secondary\">See how it works</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;min-height:44px;padding:.7rem 1.4rem;border:0;border-radius:999px;font:700 1rem/1.5 \"DM Sans\",system-ui,sans-serif;cursor:pointer;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),background-color 160ms cubic-bezier(0.23,1,0.32,1),color 160ms cubic-bezier(0.23,1,0.32,1)}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:2px solid var(--fp-primary,#0e7c6b);outline-offset:3px}@media (prefers-reduced-motion:reduce){.ds-btn{transition:none}.ds-btn:active{transform:none}}.ds-btn-secondary{background:var(--fp-pill,#e4e4e2);color:var(--fp-ink,#111)}.ds-btn-secondary:hover{background:var(--fp-pill-hover,#d9d9d7)}"
    },
    {
      "name": "Brand Button",
      "kind": "button",
      "refersTo": "button-brand",
      "description": "Teal pill: as an action, the nav only (\"New hangout\", \"Log in\"); elsewhere a teal fill means selected.",
      "html": "<button class=\"ds-btn ds-btn-brand\">New hangout</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;min-height:44px;padding:.7rem 1.4rem;border:0;border-radius:999px;font:700 1rem/1.5 \"DM Sans\",system-ui,sans-serif;cursor:pointer;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),background-color 160ms cubic-bezier(0.23,1,0.32,1),color 160ms cubic-bezier(0.23,1,0.32,1)}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:2px solid var(--fp-primary,#0e7c6b);outline-offset:3px}@media (prefers-reduced-motion:reduce){.ds-btn{transition:none}.ds-btn:active{transform:none}}.ds-btn-brand{background:var(--fp-primary,#0e7c6b);color:var(--fp-bg,#fff)}.ds-btn-brand:hover{background:var(--fp-primary-dark,#0a5f52)}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "field",
      "description": "56px grey field; white with a teal border on focus.",
      "html": "<label class=\"ds-label\" for=\"ds-email\">Email</label><input id=\"ds-email\" class=\"ds-field\" placeholder=\"you@u.nus.edu\">",
      "css": ".ds-label{display:block;margin-bottom:.4rem;font:600 .95rem \"DM Sans\",system-ui,sans-serif;color:var(--fp-ink,#111)}.ds-field{box-sizing:border-box;width:100%;min-height:56px;padding:0 1.1rem;background:var(--fp-surface,#f5f5f3);border:2px solid transparent;border-radius:16px;font:500 1.0625rem \"DM Sans\",system-ui,sans-serif;color:var(--fp-ink,#111);transition:background-color 160ms,border-color 160ms}.ds-field::placeholder{color:var(--fp-faint,#707070)}.ds-field:focus{outline:none;background:var(--fp-raised,#fff);border-color:var(--fp-primary,#0e7c6b)}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "button-brand",
      "description": "White bar, teal Fraunces wordmark, teal underlined active link, teal pill.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-wordmark\" href=\"#\">fairpoint</a><div class=\"ds-links\"><a class=\"ds-link ds-on\" href=\"#\">My hangouts</a><a class=\"ds-link\" href=\"#\">Groups</a><a class=\"ds-link\" href=\"#\">Preferences</a></div><a class=\"ds-pill\" href=\"#\">New hangout</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:88px;padding:0 2rem;background:var(--fp-bg,#fff);border-bottom:1px solid var(--fp-border,#e6e6e6);font-family:\"DM Sans\",system-ui,sans-serif}.ds-wordmark{font:900 2.125rem/1 Fraunces,Georgia,serif;letter-spacing:-.02em;color:var(--fp-primary,#0e7c6b);text-decoration:none}.ds-links{display:flex;gap:2.75rem}.ds-link{display:inline-flex;align-items:center;min-height:44px;border-bottom:2px solid transparent;color:var(--fp-ink,#111);font-size:1.125rem;font-weight:500;text-decoration:none}.ds-link:hover{color:var(--fp-primary-dark,#0a5f52)}.ds-link.ds-on{color:var(--fp-primary,#0e7c6b);border-bottom-color:var(--fp-primary,#0e7c6b);font-weight:700}.ds-pill{display:inline-flex;align-items:center;min-height:44px;padding:.7rem 1.4rem;border-radius:999px;background:var(--fp-primary,#0e7c6b);color:var(--fp-bg,#fff);font-weight:700;text-decoration:none}.ds-pill:hover{background:var(--fp-primary-dark,#0a5f52)}.ds-link:focus-visible,.ds-pill:focus-visible{outline:2px solid var(--fp-primary,#0e7c6b);outline-offset:3px}"
    },
    {
      "name": "Status Pills",
      "kind": "chip",
      "refersTo": "status-pill",
      "description": "Dot plus tint: default, live deadline (coral), confirmed (teal).",
      "html": "<span class=\"ds-status\">Not confirmed yet</span> <span class=\"ds-status ds-live\">Vote closes in 2h</span> <span class=\"ds-status ds-ok\">Confirmed spot</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:.5rem;padding:.4rem .85rem;border-radius:999px;background:var(--fp-pill,#e4e4e2);color:var(--fp-ink,#111);font:700 .875rem \"DM Sans\",system-ui,sans-serif}.ds-status::before{content:\"\";width:8px;height:8px;border-radius:50%;background:var(--fp-disabled,#8a8a8a)}.ds-live{background:var(--fp-accent-tint,#fde7e1);color:var(--fp-accent-text,#a3341b)}.ds-live::before{background:var(--fp-accent,#f2684a)}.ds-ok{background:var(--fp-tint,#e8f3f0);color:var(--fp-primary-dark,#0a5f52)}.ds-ok::before{background:var(--fp-primary,#0e7c6b)}"
