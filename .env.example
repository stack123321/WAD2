# Copy this file to .env.local and fill in your own keys. .env.local is never committed.

# Front end (VITE_ prefix = visible in the browser, so only public keys here)
VITE_SUPABASE_URL=
# Supabase → Connect (or Project Settings → API Keys): the "publishable" key, sb_publishable_...
# (the older "anon" key also works). Never the secret / service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only (used by the functions in api/; no VITE_ prefix, never sent to the browser)
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
LTA_ACCOUNT_KEY=
GOOGLE_PLACES_API_KEY=
# Google AI Studio (aistudio.google.com → Get API key), for the Ask box on 09 (api/assistant.js).
# Optional: GEMINI_MODEL=<model name> if the default model is retired.
GEMINI_API_KEY=

# Live tests only (npm run test:live, tests/live/): real test accounts on the Supabase project.
# The second account is for the tests with two people (invite, vote together).
E2E_EMAIL=
E2E_PASSWORD=
E2E_EMAIL_2=
E2E_PASSWORD_2=
